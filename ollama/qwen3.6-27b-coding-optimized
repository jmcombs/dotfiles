FROM qwen3.6:27b-coding-mxfp8

# Qwen official recommendation for precise coding tasks (WebDev / agentic)
# This is what the -coding tag already bakes in, but we explicitly set it here
# for clarity and to override any defaults in Pi
PARAMETER temperature 0.6

# Keeps output focused while allowing enough diversity for creative solutions
PARAMETER top_p 0.95

# Makes the model more decisive — excellent for tool-calling loops in Pi
# (same "unofficial fix" you used on Gemma)
PARAMETER top_k 20

# Optional but recommended for coding agents: tiny floor on token probability
# Prevents extremely low-probability tokens that can cause weird tool calls
PARAMETER min_p 0.0

# Very light repetition control (Qwen official = 1.0)
# Community sweet spot for code: avoids repeating blocks/variables without killing creativity
PARAMETER repeat_penalty 1.05

# Presence penalty = 0 (official for coding mode)
# Keeps the model from avoiding previously used tokens too aggressively
PARAMETER presence_penalty 0.0

# Balanced context for M5 Max — perfect speed/quality balance for large codebases
# (Qwen3.6 native 256K, but 128K is faster with huge KV cache headroom)
PARAMETER num_ctx 131072

# Larger batch = noticeably faster prefill on MLX (your M5 Max loves this)
PARAMETER num_batch 512

# Let MLX auto-optimize threading on Apple Silicon
PARAMETER num_thread 0
