<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <key>Label</key>
  <string>com.ollama</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/opt/ollama/bin/ollama</string>
    <string>serve</string>
  </array>

  <!-- Never start automatically on login -->
  <key>RunAtLoad</key>
  <false/>

  <!-- Do not restart if the process exits or is stopped -->
  <key>KeepAlive</key>
  <false/>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- 256K context window; both models declare 262144 as their context size -->
    <key>OLLAMA_CONTEXT_LENGTH</key>
    <string>262144</string>
    <!-- Required complement to 256K context; reduces KV cache memory at long context lengths -->
    <key>OLLAMA_FLASH_ATTENTION</key>
    <string>1</string>
    <!-- Q8_0 KV cache halves memory vs F16 with negligible quality impact -->
    <key>OLLAMA_KV_CACHE_TYPE</key>
    <string>q8_0</string>
    <!-- Keep both models resident; combined footprint ~64GB, well within 128GB -->
    <key>OLLAMA_MAX_LOADED_MODELS</key>
    <string>2</string>
    <!-- Prevent model unloading between sessions (default 5m is disruptive for agent workflows) -->
    <key>OLLAMA_KEEP_ALIVE</key>
    <string>24h</string>
    <!-- Single parallel request; appropriate for single-user local use -->
    <key>OLLAMA_NUM_PARALLEL</key>
    <string>1</string>
  </dict>

  <!-- /tmp is cleared on reboot; no persistent log needed -->
  <key>StandardOutPath</key>
  <string>/tmp/ollama.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/ollama.log</string>

</dict>
</plist>
