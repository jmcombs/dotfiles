#!/bin/zsh

case "$1" in
  qwen)      log="/tmp/llama-qwen.log"      ;;
  gemma)     log="/tmp/llama-gemma.log"     ;;
  qwen32)    log="/tmp/llama-qwen32.log"    ;;
  devstral)  log="/tmp/llama-devstral.log"  ;;
  ornith9b)  log="/tmp/llama-ornith9b.log"  ;;
  ornith35b) log="/tmp/llama-ornith35b.log" ;;
  *)
    echo "Usage: llama-log <qwen|gemma|qwen32|devstral|ornith9b|ornith35b>"
    exit 1
    ;;
esac

tail -f "$log"
