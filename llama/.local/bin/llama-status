#!/bin/zsh

servers=(
  "11434:qwen:Qwen3.6-27B"
  "11435:gemma:Gemma4-31B"
  "11439:ornith35b:Ornith-1.0-35B-MoE"
  "11440:gptoss:gpt-oss-20b"
  "11441:qwen36moe:Qwen3.6-35B-A3B"
  "11443:glmflash:GLM-4.7-Flash"
  "11444:glmair:GLM-4.5-Air"
)

for entry in $servers; do
  port="${entry%%:*}"
  rest="${entry#*:}"
  alias="${rest%%:*}"
  name="${rest#*:}"
  if lsof -i ":$port" -sTCP:LISTEN &>/dev/null 2>&1; then
    echo "● $alias ($name) — running on :$port"
  else
    echo "○ $alias ($name) — stopped"
  fi
done
