#!/bin/zsh
set -e

case "$1" in
  qwen)       label="com.llama.qwen"       ;;
  gemma)      label="com.llama.gemma"      ;;
  qwen32)     label="com.llama.qwen32"     ;;
  ornith9b)   label="com.llama.ornith9b"   ;;
  ornith35b)  label="com.llama.ornith35b"  ;;
  gptoss)     label="com.llama.gptoss"     ;;
  gptoss120)  label="com.llama.gptoss120"  ;;
  qwen36moe)  label="com.llama.qwen36moe"  ;;
  glmflash)   label="com.llama.glmflash"   ;;
  glmair)     label="com.llama.glmair"     ;;
  *)
    echo "Usage: llama-stop <qwen|gemma|qwen32|ornith9b|ornith35b|gptoss|gptoss120|qwen36moe|glmflash|glmair>"
    exit 1
    ;;
esac

domain="gui/$(id -u)"

# Modern launchctl API: bootout stops the process AND removes the job in one
# reliable step (blocks until the process exits), unlike the legacy stop+unload
# which could silently fail and leave a stale cached job with old settings.
launchctl bootout "$domain/$label" 2>/dev/null || true
echo "Stopped $label"
