#!/bin/zsh
set -e

case "$1" in
  gemma)      label="com.llama.gemma"          ;;
  gemmamoe)   label="com.llama.gemmamoe" ;;
  gptoss)     label="com.llama.gptoss"         ;;
  ornith35b)  label="com.llama.ornith35b"      ;;
  qwen)       label="com.llama.qwen"           ;;
  qwen36moe)  label="com.llama.qwen36moe"      ;;
  *)
    echo "Usage: llama-start <gemma|gemmamoe|gptoss|ornith35b|qwen|qwen36moe>"
    exit 1
    ;;
esac

plist="$HOME/Library/LaunchAgents/$label.plist"
domain="gui/$(id -u)"

# Bulletproof (modern launchctl API): fully remove any existing/stale job first,
# so the CURRENT plist is always re-read — bootout blocks until the old process
# exits and frees its port. Then bootstrap fresh from the plist and start it
# (RunAtLoad is false, so kickstart is what actually launches the server).
launchctl bootout "$domain/$label" 2>/dev/null || true
for _ in 1 2 3 4 5; do
  launchctl bootstrap "$domain" "$plist" 2>/dev/null && break
  sleep 1
done
launchctl kickstart "$domain/$label"
echo "Started $label"
