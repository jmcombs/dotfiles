# Theme: Blue PSL 10K (unified with VS Code and Oh-My-Posh)
theme = blue-psl-10k

# ====================
# Notifications
# ====================
desktop-notifications = true

# ====================
# Font
# ====================
font-family = MesloLGS Nerd Font
font-size = 14
font-thicken = true

# ====================
# Colors (grouped together)
# ====================
# All color customizations are provided by the Blue PSL 10K theme file.

# ====================
# Window
# ====================
# Window padding (eye-friendly)
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

# Window size
window-width = 140
window-height = 40

# Translucency (macOS 26 Tahoe Liquid Glass)
# On Tahoe, background-blur = true is skipped; use the macos-glass-* modes.
# With glass, background-opacity is a TINT: lower = more glass, 0 = pure clear glass.
background-blur = macos-glass-regular
background-opacity = 0.75

# ====================
# macOS-specific
# ====================
# transparent = titlebar blends into the window bg so the glass shows through it
# (tabs = solid themed titlebar strip; swap back if you prefer that)
macos-titlebar-style = transparent
macos-option-as-alt = true